<!DOCTYPE html>
<html lang="ar" dir="rtl" id="portalHtml">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow, noarchive">
  <meta property="og:type" content="website">
  <meta property="og:title" content="منصة إدارة ومتابعة المكتب | مكتب المحامي علي كاظم الهاشمي">
  <meta property="og:image" content="https://akjassem.com/og-logo.jpg">
  <title>منصة إدارة ومتابعة المكتب | مكتب المحامي علي كاظم الهاشمي</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Cairo', system-ui, -apple-system, sans-serif;
      background-color: #f4f6f9;
      color: #0b1c36;
      min-height: 100vh;
      padding: 20px 14px 40px;
    }
    .container {
      max-width: 1120px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 16px;
      border-top: 6px solid #c59b27;
      box-shadow: 0 12px 36px rgba(11, 28, 54, 0.08);
      padding: 28px 24px;
    }
    .brand-header {
      text-align: center;
      padding-bottom: 18px;
      border-bottom: 1px solid #e2e8f0;
      margin-bottom: 20px;
    }
    .logo-text {
      font-size: 40px;
      font-weight: 900;
      color: #0b1c36;
      letter-spacing: 2px;
      line-height: 1.05;
      direction: ltr;
    }
    .logo-text .k-red { color: #d32f2f; }
    .sub-title {
      font-size: 12.5px;
      font-weight: 700;
      color: #64748b;
      letter-spacing: 3px;
      margin-top: 6px;
      direction: ltr;
    }
    .sub-title .slash-red { color: #d32f2f; font-weight: 800; }
    .est { font-size: 11px; color: #94a3b8; margin-top: 2px; direction: ltr; letter-spacing: 1px; }
    .office-heading { font-size: 20px; font-weight: 800; color: #0b1c36; margin-top: 10px; }
    .system-subtitle { font-size: 13.5px; font-weight: 700; color: #92400e; margin-top: 2px; }

    .card {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 18px;
    }
    .card-title {
      font-size: 16px;
      font-weight: 800;
      color: #0b1c36;
      margin-bottom: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }

    .top-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 18px;
      background: #0b1c36;
      color: #ffffff;
      padding: 12px 16px;
      border-radius: 12px;
      border-bottom: 3px solid #c59b27;
    }
    .badge-secure {
      background: rgba(255,255,255,0.12);
      color: #fde68a;
      padding: 5px 12px;
      border-radius: 20px;
      font-size: 12.5px;
      font-weight: 700;
    }
    .toolbar-actions { display: flex; flex-wrap: wrap; gap: 6px; }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
      margin-bottom: 18px;
    }
    @media (max-width: 900px) { .stats-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 550px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }

    .stat-box {
      background: #ffffff;
      border: 1.5px solid #e2e8f0;
      border-radius: 10px;
      padding: 12px 10px;
      text-align: center;
    }
    .stat-label { font-size: 12px; color: #64748b; font-weight: 700; }
    .stat-val { font-size: 16px; font-weight: 900; color: #0b1c36; margin-top: 4px; }

    .nav-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 18px;
      border-bottom: 2px solid #e2e8f0;
      padding-bottom: 12px;
    }
    .nav-tab {
      background: #f8fafc;
      border: 1.5px solid #cbd5e1;
      color: #334155;
      padding: 9px 16px;
      border-radius: 9px;
      font-family: 'Cairo', sans-serif;
      font-size: 13.5px;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.2s;
    }
    .nav-tab.active {
      background: #0b1c36;
      color: #ffffff;
      border-color: #0b1c36;
      border-bottom: 3px solid #c59b27;
    }

    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
    @media (max-width: 780px) { .grid-3, .grid-4 { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 560px) { .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; } }

    .form-group { margin-bottom: 12px; }
    label { display: block; font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 5px; }
    input, select, textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1.5px solid #cbd5e1;
      border-radius: 8px;
      font-family: 'Cairo', sans-serif;
      font-size: 13.5px;
      background: #ffffff;
      color: #0b1c36;
    }
    input:focus, select:focus, textarea:focus { outline: none; border-color: #c59b27; }

    .btn {
      padding: 11px 18px;
      background: #0b1c36;
      color: #ffffff;
      border: none;
      border-radius: 8px;
      font-family: 'Cairo', sans-serif;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
    }
    .btn:hover { background: #162e54; }
    .btn-gold { background: #c59b27; color: #0b1c36; }
    .btn-gold:hover { background: #b0881e; }

    .btn-sm {
      padding: 6px 11px;
      border-radius: 7px;
      font-family: 'Cairo', sans-serif;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      border: 1.5px solid #cbd5e1;
      background: #ffffff;
      color: #0b1c36;
    }
    .btn-sm:hover { border-color: #c59b27; }
    .btn-dark-bar { background: rgba(255,255,255,0.12); border-color: rgba(255,255,255,0.28); color: #ffffff; }
    .btn-dark-bar:hover { background: #c59b27; color: #0b1c36; border-color: #c59b27; }
    .btn-green { background: #f0fdf4; border-color: #86efac; color: #166534; }
    .btn-red { background: #fef2f2; border-color: #fecaca; color: #991b1b; }
    .btn-blue { background: #eff6ff; border-color: #bfdbfe; color: #1e40af; }

    .record-card {
      background: #ffffff;
      border: 1.5px solid #e2e8f0;
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 12px;
      transition: border-color 0.2s;
    }
    .record-card:hover { border-color: #c59b27; }
    .rec-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 8px;
    }
    .ref-badge {
      font-family: monospace;
      font-size: 12.5px;
      font-weight: 800;
      background: #0b1c36;
      color: #c59b27;
      padding: 3px 9px;
      border-radius: 6px;
      direction: ltr;
      display: inline-block;
    }
    .type-badge {
      font-size: 12px;
      font-weight: 800;
      padding: 3px 10px;
      border-radius: 6px;
      background: #f1f5f9;
      color: #0b1c36;
      border: 1px solid #cbd5e1;
    }
    .stage-pill {
      font-size: 12px;
      font-weight: 800;
      padding: 3px 11px;
      border-radius: 20px;
    }
    .st-consult { background: #e0f2fe; color: #075985; }
    .st-signing { background: #fef3c7; color: #92400e; }
    .st-active { background: #dcfce7; color: #166534; }
    .st-waiting { background: #ffedd5; color: #9a3412; }
    .st-completed { background: #d1fae5; color: #065f46; }
    .st-closed { background: #f1f5f9; color: #475569; }
    .st-open-cmp { background: #fee2e2; color: #991b1b; }

    .rec-title { font-size: 15.5px; font-weight: 800; color: #0b1c36; margin: 4px 0; }
    .rec-meta { font-size: 13px; color: #475569; line-height: 1.7; margin-bottom: 10px; }
    .fin-bar {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 9px 12px;
      font-size: 12.5px;
      font-weight: 700;
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-bottom: 10px;
    }
    .rec-actions { display: flex; flex-wrap: wrap; gap: 6px; }

    .hidden { display: none !important; }

    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(11, 28, 54, 0.75);
      backdrop-filter: blur(4px);
      z-index: 1000;
      padding: 16px;
      align-items: center;
      justify-content: center;
    }
    .modal-overlay.open { display: flex; }
    .modal-card {
      background: #ffffff;
      border-top: 5px solid #c59b27;
      border-radius: 14px;
      width: 100%;
      max-width: 720px;
      max-height: 90vh;
      overflow-y: auto;
      padding: 22px;
      box-shadow: 0 25px 50px rgba(0,0,0,0.35);
    }
    .modal-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 10px;
      margin-bottom: 14px;
      border-bottom: 1px solid #e2e8f0;
    }

    .sub-table {
      width: 100%;
      border-collapse: collapse;
      margin: 10px 0;
      font-size: 12.5px;
    }
    .sub-table th, .sub-table td {
      border: 1px solid #cbd5e1;
      padding: 7px 9px;
      text-align: start;
    }
    .sub-table th { background: #f1f5f9; color: #0b1c36; }

    .toast-banner {
      display: none;
      position: fixed;
      bottom: 20px;
      inset-inline-end: 20px;
      background: #0b1c36;
      color: #ffffff;
      border-bottom: 3px solid #c59b27;
      padding: 11px 18px;
      border-radius: 10px;
      font-size: 13.5px;
      font-weight: 700;
      z-index: 1500;
      box-shadow: 0 10px 25px rgba(11, 28, 54, 0.25);
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="brand-header">
      <div class="logo-text">A<span class="k-red">K</span>H</div>
      <div class="sub-title"><span class="slash-red">/</span> LAW OFFICE</div>
      <div class="est">EST. 2014</div>
      <div class="office-heading">مكتب المحامي علي كاظم الهاشمي</div>
      <div class="system-subtitle">منظومة إدارة ومتابعة الملفات القانونية وضبط الجودة (ISO)</div>
    </div>

    <!-- شاشة التأسيس الأولي -->
    <div id="setup-view" class="card hidden" style="max-width:480px; margin:20px auto;">
      <div class="card-title">🔐 تأسيس منظومة المكتب (لأول مرة)</div>
      <p style="font-size:13px; color:#475569; margin-bottom:14px;">
        هذا النظام مستقل تماماً عن منصة المدفوعات والحجوزات، ومحمى برقم سري خاص لإدارة الموكلين، الاستشارات، الدعاوى، المعاملات، وتجزئة الأتعاب.
      </p>
      <div class="form-group">
        <label>اختر الرقم السري للدخول (PIN - 4 أرقام أو أكثر):</label>
        <input type="password" id="setup-pin" placeholder="••••••">
      </div>
      <button class="btn btn-gold" style="width:100%;" onclick="setupPortalVault()">تفعيل وحفظ الرقم السري</button>
    </div>

    <!-- شاشة القفل -->
    <div id="unlock-view" class="card hidden" style="max-width:440px; margin:20px auto;">
      <div class="card-title">🔒 المنظومة مقفلة</div>
      <div class="form-group">
        <label>أدخل الرقم السري (PIN) لفتح سجلات المكتب:</label>
        <input type="password" id="unlock-pin" placeholder="••••••" onkeypress="if(event.key==='Enter') unlockPortalVault()">
      </div>
      <button class="btn" style="width:100%;" onclick="unlockPortalVault()">دخول إلى المنظومة</button>
    </div>

    <!-- لوحة الإدارة الرئيسية -->
    <div id="main-dashboard" class="hidden">
      <div class="top-toolbar">
        <span class="badge-secure">🟢 السجل نشط ومؤمّن — أرشفة مفتوحة المدة</span>
        <div class="toolbar-actions">
          <button class="btn-sm btn-dark-bar" onclick="exportFullBackupJSON()">تصدير نسخة احتياطية JSON</button>
          <button class="btn-sm btn-dark-bar" onclick="exportMattersCSV()">تصدير كشف CSV</button>
          <label class="btn-sm btn-dark-bar" style="cursor:pointer; margin:0;">
            استيراد نسخة
            <input type="file" accept=".json" style="display:none;" onchange="importFullBackupJSON(event)">
          </label>
          <button class="btn-sm btn-dark-bar" onclick="printAuditSummary()">🖨️ كشف التدقيق والجودة</button>
          <button class="btn-sm btn-dark-bar" onclick="lockPortalVault()">قفل 🔒</button>
        </div>
      </div>

      <!-- الإحصائيات الفورية -->
      <div class="stats-grid">
        <div class="stat-box">
          <div class="stat-label">الموكلون الدائمون</div>
          <div class="stat-val" id="stat-clients">0</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">قيد الاستشارة / التوقيع</div>
          <div class="stat-val" id="stat-intake">0</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">ملفات جارية بالعمل</div>
          <div class="stat-val" id="stat-active">0</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">مغلقة ومؤرشفة مرجعياً</div>
          <div class="stat-val" id="stat-closed">0</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">الشكاوى المفتوحة</div>
          <div class="stat-val" id="stat-complaints">0</div>
        </div>
      </div>

      <!-- التبويبات الرئيسية -->
      <div class="nav-tabs">
        <button class="nav-tab active" id="tab-btn-matters" onclick="switchMainTab('matters')">📁 الملفات (استشارة / دعوى / معاملة)</button>
        <button class="nav-tab" id="tab-btn-clients" onclick="switchMainTab('clients')">👤 سجل الموكلين الدائم</button>
        <button class="nav-tab" id="tab-btn-complaints" onclick="switchMainTab('complaints')">⚖️ سجل الشكاوى والملاحظات</button>
      </div>

      <!-- القسم 1: الملفات (استشارة / دعوى / معاملة) -->
      <div id="sec-matters">
        <div class="card">
          <div class="card-title">
            <span>➕ فتح ملف جديد (استشارة / دعوى قضائية / معاملة إجرائية)</span>
            <button class="btn-sm" onclick="toggleBox('new-matter-form')">إظهار / إخفاء النموذج</button>
          </div>
          <div id="new-matter-form">
            <div class="grid-3">
              <div class="form-group">
                <label>الباب / التصنيف الرئيسي *:</label>
                <select id="m-category" onchange="updateCategoryFields()">
                  <option value="consultation">استشارة قانونية (Consultation)</option>
                  <option value="lawsuit">دعوى قضائية (Lawsuit)</option>
                  <option value="transaction">معاملة إجرائية / عقد (Transaction)</option>
                </select>
              </div>
              <div class="form-group">
                <label>مرحلة الملف الحالية *:</label>
                <select id="m-stage">
                  <option value="consultation">1. استشارة وتقييم الطلب</option>
                  <option value="signing">2. قيد التوقيع والتوكيل / صياغة العقد</option>
                  <option value="active">3. جاري العمل والمباشرة بالإجراءات</option>
                  <option value="waiting">4. بانتظار إجراء / تبليغ / دائرة</option>
                  <option value="completed">5. منجز ومسلّم</option>
                  <option value="closed">6. مغلق ومؤرشف مرجعياً</option>
                </select>
              </div>
              <div class="form-group">
                <label>اختر من سجل الموكلين (أو أضف جديداً أدناه):</label>
                <select id="m-client-select" onchange="fillClientFromSelect()">
                  <option value="">— موكّل / مراجع جديد —</option>
                </select>
              </div>
            </div>

            <div class="grid-3">
              <div class="form-group">
                <label>اسم المراجع / الموكل *:</label>
                <input type="text" id="m-client-name" placeholder="الاسم الكامل أو اسم الشركة">
              </div>
              <div class="form-group">
                <label>صفة المراجع / الموكل:</label>
                <select id="m-client-type">
                  <option value="فرد عراقي">فرد عراقي</option>
                  <option value="شركة عراقية">شركة عراقية</option>
                  <option value="فرد أجنبي">فرد أجنبي</option>
                  <option value="شركة أجنبية">شركة أجنبية</option>
                </select>
              </div>
              <div class="form-group">
                <label>رقم الهاتف / واتساب:</label>
                <input type="text" id="m-client-phone" placeholder="+9647700000000" dir="ltr">
              </div>
            </div>

            <div class="grid-2">
              <div class="form-group">
                <label>موضوع الاستشارة / الدعوى / المعاملة *:</label>
                <input type="text" id="m-title" placeholder="مثال: تأسيس شركة / دعوى إزالة شيوع / تسجيل علامة تجارية">
              </div>
              <div class="form-group">
                <label id="lbl-m-forum">الجهة / المحكمة / الدائرة المختصة:</label>
                <input type="text" id="m-forum" placeholder="مثال: مسجل الشركات - وزارة التجارة / علامات تجارية - وزارة الصناعة والمعادن / محكمة بداءة الكرادة">
              </div>
            </div>

            <div class="grid-4">
              <div class="form-group">
                <label>رقم الحجز أو الدعوى / الإضبارة:</label>
                <input type="text" id="m-case-no" placeholder="رقم الدعوى أو الإضبارة">
              </div>
              <div class="form-group">
                <label>حالة وتاريخ العقد:</label>
                <input type="text" id="m-contract-info" placeholder="مثال: موقّع بتاريخ 2026-11-21">
              </div>
              <div class="form-group">
                <label>رقم وتاريخ الوكالة:</label>
                <input type="text" id="m-poa-info" placeholder="مثال: وكالة عامة رقم 1245">
              </div>
              <div class="form-group">
                <label>موعد المرافعة / المراجعة القادم:</label>
                <input type="date" id="m-next-date">
              </div>
            </div>

            <div class="grid-3">
              <div class="form-group">
                <label>العملة المعتمدة للاتفاق:</label>
                <select id="m-currency">
                  <option value="IQD">دينار عراقي (IQD)</option>
                  <option value="USD">دولار أمريكي (USD)</option>
                </select>
              </div>
              <div class="form-group">
                <label>إجمالي الأتعاب المتفق عليها (السقف المالي):</label>
                <input type="number" id="m-total-fee" placeholder="0">
              </div>
              <div class="form-group">
                <label>رقم فاتورة الدفعة الأولى (من منصة المدفوعات - اختياري):</label>
                <input type="text" id="m-first-inv" placeholder="AKH-2026-...">
              </div>
            </div>

            <div class="grid-2">
              <div class="form-group">
                <label>مبلغ الدفعة الأولى المستلمة (إن وُجد):</label>
                <input type="number" id="m-first-paid" placeholder="0">
              </div>
              <div class="form-group">
                <label>ملاحظات التوثيق، مرفقات العقد، أو مستجدات المتابعة:</label>
                <input type="text" id="m-notes" placeholder="تفاصيل ما تم إنجازه أو المستندات المستلمة">
              </div>
            </div>

            <button class="btn btn-gold" onclick="addNewMatter()">حفظ الملف في السجل الدائم ✓</button>
          </div>
        </div>

        <!-- فلاتر البحث والتصفية مفتوحة المدة -->
        <div class="card">
          <div class="card-title"><span>🔍 البحث والتصفية (أرشيف مفتوح المدة)</span></div>
          <div class="grid-4">
            <input type="text" id="f-search" placeholder="بحث بالاسم، الرقم المرجعي، المحكمة، الفاتورة..." oninput="renderAll()">
            <select id="f-category" onchange="renderAll()">
              <option value="all">كل الأبواب (استشارة / دعوى / معاملة)</option>
              <option value="consultation">الاستشارات فقط</option>
              <option value="lawsuit">الدعاوى القضائية فقط</option>
              <option value="transaction">المعاملات الإجرائية والعقود فقط</option>
            </select>
