<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <title>Matter & Client Portal | بوابة الملفات والموكلين</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #f6f5f2;
      --surface: #ffffff;
      --surface-soft: #faf9f6;
      --ink: #111827;
      --navy: #14213d;
      --gold: #c69a3f;
      --gold-soft: #f8f3e6;
      --red: #c81e2b;
      --muted: #647084;
      --border: #e5e0d6;
      --ok: #157347;
      --ok-bg: #e8f5ee;
      --warn: #b4690e;
      --warn-bg: #fef4e6;
      --danger: #b42318;
      --danger-bg: #feeceb;
      --info: #1d4ed8;
      --info-bg: #eff6ff;
      --radius: 16px;
      --shadow: 0 8px 24px rgba(17, 24, 39, 0.05);
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: 'Cairo', 'Plus Jakarta Sans', sans-serif;
      line-height: 1.6;
    }

    .en {
      font-family: 'Plus Jakarta Sans', sans-serif;
      direction: ltr;
      unicode-bidi: isolate;
    }

    .k-red, .slash-red { color: var(--red); }

    /* Clean Light Brand Card (Matches site & lock screen) */
    .brand-card {
      background: #ffffff;
      border: 1px solid #ece8df;
      border-top: 4px solid var(--gold);
      border-radius: 18px;
      padding: 20px 18px;
      box-shadow: var(--shadow);
      text-align: center;
    }
    .logo-frame {
      background: #ffffff;
      border: 1px solid #eeeae0;
      border-radius: 14px;
      padding: 14px 16px;
      margin: 0 auto 12px;
      max-width: 250px;
      direction: ltr;
    }
    .akh-letters {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 800;
      font-size: 34px;
      letter-spacing: 1px;
      line-height: 1.05;
      color: var(--ink);
    }
    .akh-law-line {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 2.2px;
      color: var(--ink);
      margin-top: 5px;
    }
    .akh-est-line {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 2px;
      color: #6b7280;
      margin-top: 3px;
    }
    .office-name {
      font-size: 20px;
      font-weight: 800;
      color: var(--ink);
      margin: 6px 0 2px;
    }
    .portal-tag {
      font-size: 13px;
      font-weight: 700;
      color: var(--gold);
    }

    /* Lock Screen */
    .lock-wrap {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 18px;
    }
    .lock-box {
      width: 100%;
      max-width: 440px;
    }
    .lock-panel {
      margin-top: 14px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px;
      box-shadow: var(--shadow);
      text-align: right;
    }

    /* Container & Light Header */
    .container {
      max-width: 1220px;
      margin: 18px auto 60px;
      padding: 0 14px;
    }
    .header-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin-top: 14px;
    }

    /* Buttons */
    button, .btn {
      font-family: inherit;
      font-size: 13px;
      font-weight: 700;
      border-radius: 11px;
      padding: 9px 14px;
      border: 1px solid transparent;
      cursor: pointer;
      transition: 0.16s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      text-decoration: none;
    }
    .btn-dark { background: var(--ink); color: #fff; }
    .btn-dark:hover { background: #222d42; }
    .btn-gold { background: var(--gold); color: #fff; }
    .btn-gold:hover { filter: brightness(0.96); }
    .btn-light { background: #fff; color: var(--ink); border-color: var(--border); }
    .btn-light:hover { background: var(--surface-soft); }
    .btn-ok { background: var(--ok); color: #fff; }
    .btn-danger { background: var(--danger); color: #fff; }
    .btn-sm { padding: 6px 10px; font-size: 12px; border-radius: 8px; }

    /* Stats */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
      gap: 10px;
      margin: 16px 0;
    }
    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 13px 15px;
      box-shadow: var(--shadow);
    }
    .stat-title { font-size: 12px; font-weight: 700; color: var(--muted); }
    .stat-sub { font-size: 10.5px; color: var(--gold); font-family: 'Plus Jakarta Sans', sans-serif; display: block; }
    .stat-num { font-size: 21px; font-weight: 800; color: var(--ink); margin-top: 4px; }

    /* Tabs */
    .tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 14px;
    }
    .tab-btn {
      background: var(--surface);
      color: var(--muted);
      border: 1px solid var(--border);
      padding: 9px 14px;
      border-radius: 11px;
    }
    .tab-btn.active {
      background: var(--ink);
      color: #fff;
      border-color: var(--ink);
    }

    /* Panels & Forms */
    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px;
      box-shadow: var(--shadow);
      margin-bottom: 14px;
    }
    .panel-head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 10px;
      margin-bottom: 14px;
    }
    .panel-head h2 { margin: 0; font-size: 15.5px; color: var(--ink); }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(215px, 1fr));
      gap: 10px;
    }
    .field { display: flex; flex-direction: column; gap: 5px; }
    .field label { font-size: 12.5px; font-weight: 700; color: var(--ink); }
    input, select, textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--border);
      border-radius: 10px;
      font-family: inherit;
      font-size: 13.5px;
      background: #fff;
      color: var(--ink);
    }
    input:focus, select:focus, textarea:focus { outline: none; border-color: var(--gold); }

    /* Matter Cards + Barcode */
    .matter-list { display: grid; gap: 12px; }
    .matter-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-right: 4px solid var(--gold);
      border-radius: var(--radius);
      padding: 15px;
      box-shadow: var(--shadow);
    }
    .matter-top {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px;
    }
    .ref-pill {
      display: inline-block;
      background: var(--gold-soft);
      color: var(--ink);
      border: 1px solid #e4d0a2;
      padding: 2px 9px;
      border-radius: 7px;
      font-size: 12px;
      font-weight: 700;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .barcode-box {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 6px 10px;
      text-align: center;
      min-width: 130px;
    }
    .barcode-bars {
      height: 26px;
      background: repeating-linear-gradient(
        90deg,
        #111827 0px, #111827 2px,
        transparent 2px, transparent 4px,
        #111827 4px, #111827 5px,
        transparent 5px, transparent 8px,
        #111827 8px, #111827 11px,
        transparent 11px, transparent 13px
      );
    }
    .barcode-code {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 10px;
      font-weight: 700;
      color: var(--muted);
      margin-top: 2px;
      letter-spacing: 0.6px;
    }

    .badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 11.5px;
      font-weight: 700;
    }
    .b-info { background: var(--info-bg); color: var(--info); }
    .b-warn { background: var(--warn-bg); color: var(--warn); }
    .b-ok { background: var(--ok-bg); color: var(--ok); }
    .b-danger { background: var(--danger-bg); color: var(--danger); }

    .lifecycle {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 10px 0;
      padding: 8px;
      background: var(--surface-soft);
      border-radius: 10px;
      border: 1px solid var(--border);
    }
    .step-chip {
      font-size: 11px;
      padding: 4px 9px;
      border-radius: 7px;
      background: #ece8df;
      color: var(--muted);
      font-weight: 700;
    }
    .step-chip.done { background: var(--ok-bg); color: var(--ok); }
    .step-chip.current { background: var(--ink); color: #fff; }
    .step-chip.cancelled { background: var(--danger-bg); color: var(--danger); }

    .meta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      font-size: 12.5px;
      color: var(--muted);
      margin-top: 6px;
    }
    .card-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
      padding-top: 10px;
      border-top: 1px dashed var(--border);
    }

    /* Modal */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(17, 24, 39, 0.5);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
      z-index: 90;
    }
    .modal-backdrop.open { display: flex; }
    .modal {
      background: #fff;
      width: 100%;
      max-width: 820px;
      max-height: 90vh;
      overflow-y: auto;
      border-radius: 16px;
      padding: 20px;
      border-top: 4px solid var(--gold);
    }

    table { width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 10px; }
    th, td { border: 1px solid var(--border); padding: 8px 10px; text-align: right; }
    th { background: var(--surface-soft); color: var(--ink); }

    .hidden { display: none !important; }
    .toast {
      position: fixed;
      bottom: 18px;
      left: 18px;
      background: var(--ink);
      color: #fff;
      border-right: 4px solid var(--gold);
      padding: 11px 15px;
      border-radius: 10px;
      font-size: 13px;
      z-index: 120;
      display: none;
    }

    @media print {
      .tabs, .no-print, .card-actions, .header-actions { display: none !important; }
      body { background: #fff; }
      .panel, .matter-card, .brand-card { box-shadow: none; border: 1px solid #ccc; }
    }
  </style>
</head>
<body>

  <!-- LOCK / SETUP -->
  <div id="lockScreen" class="lock-wrap">
    <div class="lock-box">
      <div class="brand-card">
        <div class="logo-frame">
          <div class="akh-letters">A<span class="k-red">K</span>H</div>
          <div class="akh-law-line"><span class="slash-red">/</span> LAW OFFICE</div>
          <div class="akh-est-line">EST. 2014</div>
        </div>
        <div class="office-name">مكتب المحامي علي كاظم الهاشمي</div>
        <div class="portal-tag"><span class="en">Matter &amp; Client Portal</span> — بوابة الملفات والموكلين</div>
      </div>

      <div class="lock-panel">
        <div id="setupModeText">
          <strong>تأسيس البوابة (لأول مرة)</strong>
          <p style="font-size:12.5px; color:var(--muted); margin:6px 0 12px;">
            بوابة مستقلة لإدارة دورة حياة الملفات وربط الحجز والباركود والفوترة، محمية برقم سري وممنوعة من الأرشفة.
          </p>
        </div>
        <div id="unlockModeText" class="hidden">
          <strong>تسجيل الدخول الآمن</strong>
          <p style="font-size:12.5px; color:var(--muted); margin:6px 0 12px;">
            أدخل الرقم السري (PIN) لفتح سجلات الموكلين والملفات.
          </p>
        </div>

        <div class="field" style="margin-bottom:10px;">
          <label>الرقم السري للدخول (PIN - 4 أرقام أو أكثر)</label>
          <input type="password" id="pinInput" placeholder="••••••" autocomplete="off" />
        </div>

        <div id="tokenSetupField" class="field" style="margin-bottom:12px;">
          <label>رمز المزامنة السحابية اختياري <span class="en">(GitHub Token: ghp_...)</span></label>
          <input type="password" id="ghTokenInput" placeholder="اتركه فارغاً للحفظ المحلي أو ألصق ghp_..." autocomplete="off" />
        </div>

        <button class="btn-dark" style="width:100%;" onclick="handleAuth()">فتح البوابة الآن</button>
      </div>
    </div>
  </div>

  <!-- MAIN PORTAL -->
  <div id="appShell" class="hidden">
    <main class="container">
      <!-- Clean Brand Header -->
      <section class="brand-card">
        <div class="logo-frame">
          <div class="akh-letters">A<span class="k-red">K</span>H</div>
          <div class="akh-law-line"><span class="slash-red">/</span> LAW OFFICE</div>
          <div class="akh-est-line">EST. 2014</div>
        </div>
        <div class="office-name">مكتب المحامي علي كاظم الهاشمي — <span class="en">Law Office Of Ali Kadhem Hashimi</span></div>
        <div class="portal-tag"><span class="en">Matter &amp; Client Portal</span> — بوابة الملفات والموكلين</div>

        <div class="header-actions">
          <button class="btn-gold" onclick="openNewMatterModal()">+ حجز / ملف جديد (باركود)</button>
          <a class="btn btn-light" href="https://akjassem.com/booking" target="_blank" rel="noopener">صفحة الحجز (Booking AR/EN)</a>
          <button class="btn btn-light" onclick="window.print()">طباعة السجل</button>
          <button class="btn btn-light" onclick="exportBackup()">نسخة الأرشيف JSON</button>
          <button class="btn btn-light" onclick="openSettingsModal()">الإعدادات والربط</button>
          <button class="btn btn-dark" onclick="lockApp()">قفل</button>
        </div>
      </section>

      <!-- STATS -->
      <section class="stats-grid">
        <div class="stat-card">
          <div class="stat-title">الموكلون الدائمون <span class="stat-sub">Permanent Clients</span></div>
          <div class="stat-num" id="stClients">0</div>
        </div>
        <div class="stat-card">
          <div class="stat-title">الوارد / بانتظار القبول <span class="stat-sub">Incoming / Pending</span></div>
          <div class="stat-num" id="stIncoming">0</div>
        </div>
        <div class="stat-card">
          <div class="stat-title">ملفات قيد العمل <span class="stat-sub">Active Matters</span></div>
          <div class="stat-num" id="stActive">0</div>
        </div>
        <div class="stat-card">
          <div class="stat-title">ملفات ملغية / لم تُدفع <span class="stat-sub">Cancelled / Unpaid</span></div>
          <div class="stat-num" id="stCancelled">0</div>
        </div>
        <div class="stat-card">
          <div class="stat-title">الفواتير المدفوعة <span class="stat-sub">Paid Invoices</span></div>
          <div class="stat-num" id="stPaidCount">0</div>
        </div>
        <div class="stat-card">
          <div class="stat-title">مجموع المدفوعات <span class="stat-sub">Total Collected</span></div>
          <div class="stat-num" id="stCollected" style="font-size:17px;">0 IQD</div>
        </div>
      </section>

      <!-- TABS -->
      <nav class="tabs no-print">
        <button class="tab-btn active" data-tab="all" onclick="setTab('all', this)">جميع الملفات (All Matters)</button>
        <button class="tab-btn" data-tab="incoming" onclick="setTab('incoming', this)">الوارد الجديد (Intake)</button>
        <button class="tab-btn" data-tab="consultation" onclick="setTab('consultation', this)">الاستشارات (Consultations)</button>
        <button class="tab-btn" data-tab="litigation" onclick="setTab('litigation', this)">الدعاوى القضائية (Litigation)</button>
        <button class="tab-btn" data-tab="transaction" onclick="setTab('transaction', this)">المعاملات والعقود (Corporate / Deeds)</button>
        <button class="tab-btn" data-tab="clients" onclick="setTab('clients', this)">سجل الموكلين (Clients)</button>
        <button class="tab-btn" data-tab="notes" onclick="setTab('notes', this)">ملاحظات المراجعين (Client Feedback)</button>
      </nav>

      <!-- SEARCH & FILTER -->
      <div class="panel no-print" style="padding:12px 16px;">
        <div class="form-grid">
          <div class="field">
            <input type="text" id="searchInput" placeholder="بحث بالاسم، الرقم المرجعي، الباركود، الفاتورة، أو الهاتف..." oninput="render()" />
          </div>
          <div class="field">
            <select id="stageFilter" onchange="render()">
              <option value="">كل مراحل الملف (All Stages)</option>
              <option value="incoming">وارد جديد (Intake)</option>
              <option value="accepted">تم القبول - بانتظار الفاتورة (Accepted)</option>
              <option value="pending_payment">قيد الدفع (Pending Payment)</option>
              <option value="paid">تم الدفع - تحديد موعد (Paid)</option>
              <option value="in_progress">قيد التنفيذ والمتابعة (In Progress)</option>
              <option value="completed">تم الإنجاز (Completed)</option>
              <option value="archived">مؤرشف / منقول (Archived)</option>
              <option value="cancelled">ملغى / لم يُدفع (Cancelled)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- MAIN LIST VIEW -->
      <section id="mattersSection" class="matter-list"></section>

      <!-- CLIENTS VIEW -->
      <section id="clientsSection" class="panel hidden">
        <div class="panel-head">
          <h2>سجل الموكلين الدائم — <span class="en">Permanent Client Directory</span></h2>
        </div>
        <div style="overflow-x:auto;">
          <table>
            <thead>
              <tr>
                <th>الرقم الدائم (Client ID)</th>
                <th>اسم الموكل</th>
                <th>الهاتف</th>
                <th>عدد الملفات</th>
                <th>تاريخ التسجيل</th>
              </tr>
            </thead>
            <tbody id="clientsTableBody"></tbody>
          </table>
        </div>
      </section>

      <!-- NOTES VIEW -->
      <section id="notesSection" class="panel hidden">
        <div class="panel-head">
          <h2>ملاحظات المراجعين والمتابعة — <span class="en">Client Feedback &amp; Resolution Log</span></h2>
          <button class="btn-dark btn-sm" onclick="toggleFeedbackForm()">+ تسجيل ملاحظة / متابعة</button>
        </div>

        <form id="feedbackForm" class="hidden" style="margin-bottom:16px; background:var(--surface-soft); padding:14px; border-radius:12px; border:1px solid var(--border);" onsubmit="saveFeedback(event)">
          <div class="form-grid">
            <div class="field">
              <label>اسم المراجع / الموكل</label>
              <input type="text" id="fbClient" required />
            </div>
            <div class="field">
              <label>الرقم المرجعي للملف (إن وجد)</label>
              <input type="text" id="fbMatterRef" placeholder="مثال: CNS-2026-0001" />
            </div>
            <div class="field">
              <label>التصنيف</label>
              <select id="fbCategory" onchange="document.getElementById('fbCustomCat').classList.toggle('hidden', this.value !== 'custom')">
                <option value="استفسار ومتابعة">استفسار ومتابعة (Follow-up)</option>
                <option value="إعادة جدولة موعد">إعادة جدولة موعد (Reschedule)</option>
                <option value="مراجعة مالية / فاتورة">مراجعة مالية / فاتورة (Billing)</option>
                <option value="تأخر إجراء">تأخر إجراء (Delay)</option>
                <option value="custom">مخصص / أخرى (Custom)...</option>
              </select>
            </div>
            <div class="field hidden" id="fbCustomCat">
              <label>اكتب التصنيف المخصص</label>
              <input type="text" id="fbCustomCatInput" />
            </div>
          </div>
          <div class="field" style="margin-top:10px;">
            <label>التفاصيل</label>
            <textarea id="fbDetails" rows="2" required></textarea>
          </div>
          <div style="margin-top:10px; display:flex; gap:8px;">
            <button type="submit" class="btn-gold">حفظ في السجل</button>
            <button type="button" class="btn-light" onclick="toggleFeedbackForm()">إلغاء</button>
          </div>
        </form>

        <div id="feedbackList" class="matter-list"></div>
      </section>
    </main>
  </div>

  <!-- NEW MATTER / BOOKING MODAL -->
  <div id="newMatterModal" class="modal-backdrop">
    <div class="modal">
      <div class="panel-head">
        <h2>تسجيل حجز / ملف جديد وتوليد باركود — <span class="en">New Booking &amp; Barcode</span></h2>
        <button class="btn-light btn-sm" onclick="closeModal('newMatterModal')">إغلاق</button>
      </div>
      <form onsubmit="createMatter(event)">
        <div class="form-grid">
          <div class="field">
            <label>لغة الحجز / المصدر <span class="en">(Booking Source)</span></label>
            <select id="mLang" onchange="updateRefPreview()">
              <option value="AR">حجز عربي — akjassem.com (AR)</option>
              <option value="EN">حجز إنجليزي — akjassem.com (EN)</option>
              <option value="DIRECT">إدخال مباشر بالمكتب (Direct)</option>
            </select>
          </div>
          <div class="field">
            <label>الباب / التصنيف <span class="en">(Category)</span></label>
            <select id="mCategory" onchange="updateRefPreview()">
              <option value="consultation">استشارة قانونية (Consultation)</option>
              <option value="litigation">دعوى قضائية (Litigation)</option>
              <option value="transaction">معاملة إجرائية / عقد (Transaction / Contract)</option>
            </select>
          </div>
          <div class="field">
            <label>المرحلة الابتدائية <span class="en">(Initial Stage)</span></label>
            <select id="mStage">
              <option value="incoming">وارد جديد - بانتظار القبول (Intake)</option>
              <option value="accepted">تم القبول - جاهز للفاتورة (Accepted)</option>
              <option value="in_progress">مباشرة مباشرة بالعمل (In Progress)</option>
            </select>
          </div>
          <div class="field">
            <label>الرقم المرجعي والباركود التلقائي <span class="en">(Ref &amp; Barcode)</span></label>
            <input type="text" id="mRefPreview" readonly style="background:var(--gold-soft); font-weight:700;" />
          </div>
          <div class="field">
            <label>اسم المراجع / الموكل الكامل</label>
            <input type="text" id="mClientName" required />
          </div>
          <div class="field">
            <label>رقم الهاتف / واتساب</label>
            <input type="text" id="mPhone" placeholder="07..." required />
          </div>
          <div class="field">
            <label>موضوع الحجز / الملف / الاستشارة</label>
            <input type="text" id="mSubject" required />
          </div>
          <div class="field">
            <label>إجمالي الأتعاب المتفق عليها <span class="en">(Agreed Fee)</span></label>
            <input type="number" id="mFee" value="0" min="0" />
          </div>
          <div class="field">
            <label>العملة <span class="en">(Currency)</span></label>
            <select id="mCurrency">
              <option value="IQD">دينار عراقي (IQD)</option>
              <option value="USD">دولار أمريكي (USD)</option>
            </select>
          </div>
          <div class="field">
            <label>موعد الحجز / الجلسة / المراجعة</label>
            <input type="date" id="mNextDate" />
          </div>
        </div>
        <div class="field" style="margin-top:10px;">
          <label>ملاحظات أولية أو تفاصيل الحجز</label>
          <textarea id="mNotes" rows="2"></textarea>
        </div>
        <div style="margin-top:14px; display:flex; gap:8px; justify-content:flex-end;">
          <button type="button" class="btn-light" onclick="closeModal('newMatterModal')">إلغاء</button>
          <button type="submit" class="btn-gold">حفظ وتوليد الباركود</button>
        </div>
      </form>
    </div>
  </div>

  <!-- DETAIL MODAL -->
  <div id="detailModal" class="modal-backdrop">
    <div class="modal" id="detailModalBody"></div>
  </div>

  <!-- SETTINGS MODAL -->
  <div id="settingsModal" class="modal-backdrop">
    <div class="modal">
      <div class="panel-head">
        <h2>إعدادات الربط والنسخ الاحتياطي — <span class="en">Portal Settings</span></h2>
        <button class="btn-light btn-sm" onclick="closeModal('settingsModal')">إغلاق</button>
      </div>
      <div class="form-grid">
        <div class="field">
          <label>رابط منصة المدفوعات المستقلة <span class="en">(Payment Vault URL)</span></label>
          <input type="url" id="setPaymentUrl" />
        </div>
        <div class="field">
          <label>تحديث رمز المزامنة <span class="en">(GitHub Token: ghp_...)</span></label>
          <input type="password" id="setGhToken" placeholder="اختياري..." />
        </div>
      </div>
      <div style="margin-top:14px; display:flex; flex-wrap:wrap; gap:8px;">
        <button class="btn-gold" onclick="saveSettings()">حفظ الإعدادات</button>
        <label class="btn btn-light" style="cursor:pointer;">
          استعادة نسخة احتياطية JSON
          <input type="file" accept=".json" style="display:none;" onchange="importBackup(event)" />
        </label>
      </div>
    </div>
  </div>

  <div id="toast" class="toast"></div>

  <script>
    const STORAGE_KEY = 'akh_matter_portal_v8';
    const AUTH_KEY = 'akh_matter_portal_auth_v8';

    const STAGES = [
      { id: 'incoming', ar: 'وارد جديد', en: 'Intake' },
      { id: 'accepted', ar: 'تم القبول', en: 'Accepted' },
      { id: 'pending_payment', ar: 'قيد الدفع', en: 'Pending Payment' },
      { id: 'paid', ar: 'تم الدفع / موعد', en: 'Paid & Scheduled' },
      { id: 'in_progress', ar: 'قيد التنفيذ', en: 'In Progress' },
      { id: 'completed', ar: 'تم الإنجاز', en: 'Completed' },
      { id: 'archived', ar: 'مؤرشف / منقول', en: 'Archived' }
    ];

    let currentTab = 'all';
    let state = {
      settings: {
        paymentUrl: 'https://akjassem.com/akh-vault-8942x'
      },
      clients: [],
      matters: [],
      feedbacks: []
    };

    async function sha256(text) {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
      return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
    }

    function xorCipher(str, key) {
      let out = '';
      for (let i = 0; i < str.length; i++) {
        out += String.fromCharCode(str.charCodeAt(i) ^ key.charCodeAt(i % key.length));
      }
      return btoa(unescape(encodeURIComponent(out)));
    }

    function initAuthScreen() {
      const auth = JSON.parse(localStorage.getItem(AUTH_KEY) || 'null');
      if (auth && auth.pinHash) {
        document.getElementById('setupModeText').classList.add('hidden');
        document.getElementById('tokenSetupField').classList.add('hidden');
        document.getElementById('unlockModeText').classList.remove('hidden');
      }
    }

    async function handleAuth() {
      const pin = document.getElementById('pinInput').value.trim();
      if (pin.length < 4) return showToast('يرجى إدخال رقم سري من 4 أرقام أو أكثر');

      const auth = JSON.parse(localStorage.getItem(AUTH_KEY) || 'null');
      const pinHash = await sha256('AKH_' + pin);

      if (!auth) {
        const ghToken = document.getElementById('ghTokenInput').value.trim();
        const encToken = ghToken ? xorCipher(ghToken, pin) : '';
        localStorage.setItem(AUTH_KEY, JSON.stringify({ pinHash, encToken }));
        loadState();
        unlockUI();
        showToast('تم تأسيس البوابة وحفظ الحماية بنجاح');
      } else {
        if (auth.pinHash !== pinHash) return showToast('الرقم السري غير صحيح');
        loadState();
        unlockUI();
      }
    }

    function unlockUI() {
      document.getElementById('lockScreen').classList.add('hidden');
      document.getElementById('appShell').classList.remove('hidden');
      render();
    }

    function lockApp() {
      document.getElementById('pinInput').value = '';
      document.getElementById('appShell').classList.add('hidden');
      document.getElementById('lockScreen').classList.remove('hidden');
      initAuthScreen();
    }

    function loadState() {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
      if (saved) {
        state = {
          settings: { paymentUrl: 'https://akjassem.com/akh-vault-8942x', ...(saved.settings || {}) },
          clients: saved.clients || [],
          matters: saved.matters || [],
          feedbacks: saved.feedbacks || []
        };
      }
    }

    function saveState() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      render();
    }

    function generateMatterRef(category, lang) {
      const year = new Date().getFullYear();
      const prefix = category === 'litigation' ? 'CASE' : category === 'transaction' ? 'TRN' : 'CNS';
      const langTag = lang === 'EN' ? 'EN' : lang === 'AR' ? 'AR' : 'OF';
      const count = state.matters.filter(m => m.category === category).length + 1;
      return `${prefix}-${langTag}-${year}-${String(count).padStart(4, '0')}`;
    }

    function generateBarcodeToken(ref) {
      const clean = ref.replace(/[^A-Z0-9]/g, '');
      const suffix = Math.floor(1000 + Math.random() * 9000);
      return `BC-${clean}-${suffix}`;
    }

    function generateClientId() {
      const year = new Date().getFullYear();
      const count = state.clients.length + 1;
      return `CL-${year}-${String(count).padStart(4, '0')}`;
    }

    function generateInvoiceNo() {
      const year = new Date().getFullYear();
      const allInv = state.matters.reduce((sum, m) => sum + (m.invoices ? m.invoices.length : 0), 0) + 1;
      return `AKH-${year}-${String(allInv).padStart(4, '0')}`;
    }

    function openNewMatterModal() {
      updateRefPreview();
      document.getElementById('newMatterModal').classList.add('open');
    }

    function updateRefPreview() {
      const cat = document.getElementById('mCategory').value;
      const lang = document.getElementById('mLang').value;
      document.getElementById('mRefPreview').value = generateMatterRef(cat, lang);
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove('open');
    }

    function createMatter(e) {
      e.preventDefault();
      const lang = document.getElementById('mLang').value;
      const category = document.getElementById('mCategory').value;
      const stage = document.getElementById('mStage').value;
      const clientName = document.getElementById('mClientName').value.trim();
      const phone = document.getElementById('mPhone').value.trim();
      const subject = document.getElementById('mSubject').value.trim();
      const fee = Number(document.getElementById('mFee').value || 0);
      const currency = document.getElementById('mCurrency').value;
      const nextDate = document.getElementById('mNextDate').value;
      const notes = document.getElementById('mNotes').value.trim();

      let client = state.clients.find(c => c.phone === phone || c.name === clientName);
      if (!client) {
        client = {
          id: generateClientId(),
          name: clientName,
          phone,
          createdAt: new Date().toISOString().slice(0, 10)
        };
        state.clients.push(client);
      }

      const ref = generateMatterRef(category, lang);
      const barcode = generateBarcodeToken(ref);

      const matter = {
        id: Date.now().toString(),
        ref,
        barcode,
        lang,
        clientId: client.id,
        clientName: client.name,
        phone: client.phone,
        category,
        stage,
        subject,
        fee,
        currency,
        nextDate,
        invoices: [],
        timeline: [
          {
            date: new Date().toLocaleString('ar-IQ'),
            text: `تم إنشاء الملف بالرقم ${ref} والباركود ${barcode} (${stageLabel(stage)})` + (notes ? ` — ${notes}` : '')
          }
        ]
      };

      state.matters.unshift(matter);
      saveState();
      e.target.reset();
      closeModal('newMatterModal');
      showToast(`تم إنشاء الملف والباركود: ${barcode}`);
    }

    function copyBarcode(code) {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(code).catch(() => {});
      }
      showToast(`تم نسخ الباركود: ${code}`);
    }

    function stageLabel(stageId) {
      if (stageId === 'cancelled') return 'ملغى / لم يُدفع';
      const s = STAGES.find(x => x.id === stageId);
      return s ? `${s.ar} (${s.en})` : stageId;
    }

    function categoryLabel(cat) {
      if (cat === 'litigation') return 'دعوى قضائية • Litigation';
      if (cat === 'transaction') return 'معاملة / عقد • Transaction';
      return 'استشارة قانونية • Consultation';
    }

    function setTab(tab, btn) {
      currentTab = tab;
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      document.getElementById('mattersSection').classList.toggle('hidden', tab === 'clients' || tab === 'notes');
      document.getElementById('clientsSection').classList.toggle('hidden', tab !== 'clients');
      document.getElementById('notesSection').classList.toggle('hidden', tab !== 'notes');
      render();
    }

    function advanceStage(matterId, nextStage, logText) {
      const m = state.matters.find(x => x.id === matterId);
      if (!m) return;
      m.stage = nextStage;
      m.timeline.unshift({
        date: new Date().toLocaleString('ar-IQ'),
        text: logText || `تحديث المرحلة إلى: ${stageLabel(nextStage)}`
      });
      saveState();
      showToast('تم تحديث مرحلة الملف');
    }

    function triggerPaymentPortal(matterId) {
      const m = state.matters.find(x => x.id === matterId);
      if (!m) return;

      const invNo = generateInvoiceNo();
      const amount = m.fee || 0;
      m.invoices.push({
        invNo,
        amount,
        currency: m.currency,
        status: 'pending',
        date: new Date().toISOString().slice(0, 10)
      });
      m.stage = 'pending_payment';
      m.timeline.unshift({
        date: new Date().toLocaleString('ar-IQ'),
        text: `تم توليد فاتورة رقم ${invNo} بمبلغ ${amount} ${m.currency} وتحويلها إلى قيد الدفع`
      });
      saveState();

      const copyPayload = `${m.clientName} | ${m.ref} | ${m.barcode || ''} | ${invNo} | ${amount} ${m.currency}`;
      if (navigator.clipboard) {
        navigator.clipboard.writeText(copyPayload).catch(() => {});
      }
      window.open(state.settings.paymentUrl, '_blank');
      showToast(`تم توليد الفاتورة ${invNo} ونسخ البيانات وفتح منصة المدفوعات`);
    }

    function updateInvoiceStatus(matterId, invNo, status) {
      const m = state.matters.find(x => x.id === matterId);
      if (!m) return;
      const inv = m.invoices.find(i => i.invNo === invNo);
      if (!inv) return;

      inv.status = status;
      if (status === 'paid') {
        m.stage = 'paid';
        m.timeline.unshift({
          date: new Date().toLocaleString('ar-IQ'),
          text: `تأكيد سداد الفاتورة ${invNo} (${inv.amount} ${inv.currency}) — جاهز لتحديد الموعد`
        });
      } else if (status === 'cancelled') {
        m.stage = 'cancelled';
        m.timeline.unshift({
          date: new Date().toLocaleString('ar-IQ'),
          text: `إلغاء الفاتورة ${invNo} / عدم إتمام الدفع`
        });
      }
      saveState();
      openDetailModal(matterId);
    }

    function openDetailModal(matterId) {
      const m = state.matters.find(x => x.id === matterId);
      if (!m) return;

      const paidTotal = m.invoices.filter(i => i.status === 'paid').reduce((s, i) => s + Number(i.amount), 0);
      const pendingTotal = m.invoices.filter(i => i.status === 'pending').reduce((s, i) => s + Number(i.amount), 0);

      const invRows = m.invoices.length
        ? m.invoices.map(inv => `
          <tr>
            <td class="en">${inv.invNo}</td>
            <td>${inv.amount.toLocaleString()} ${inv.currency}</td>
            <td>${inv.date}</td>
            <td>
              ${inv.status === 'paid' ? '<span class="badge b-ok">مدفوعة (Paid)</span>' :
                inv.status === 'cancelled' ? '<span class="badge b-danger">ملغاة (Cancelled)</span>' :
                '<span class="badge b-warn">قيد الدفع (Pending)</span>'}
            </td>
            <td>
              ${inv.status !== 'paid' ? `<button class="btn-ok btn-sm" onclick="updateInvoiceStatus('${m.id}','${inv.invNo}','paid')">تم الدفع</button>` : ''}
              ${inv.status !== 'cancelled' ? `<button class="btn-danger btn-sm" onclick="updateInvoiceStatus('${m.id}','${inv.invNo}','cancelled')">إلغاء</button>` : ''}
            </td>
          </tr>
        `).join('')
        : '<tr><td colspan="5" style="text-align:center; color:var(--muted);">لا توجد فواتير محررة بعد</td></tr>';

      const logsHtml = m.timeline.map(t => `
        <div style="padding:8px 10px; border-bottom:1px solid var(--border); font-size:12.5px;">
          <strong style="color:var(--ink);">${t.date}:</strong> ${t.text}
        </div>
      `).join('');

      document.getElementById('detailModalBody').innerHTML = `
        <div class="panel-head">
          <div>
            <span class="ref-pill">${m.ref}</span>
            <span class="ref-pill" style="background:#eef2ff;">${m.barcode || ''}</span>
            <h2 style="margin-top:6px;">${m.subject} — ${m.clientName}</h2>
          </div>
          <button class="btn-light btn-sm" onclick="closeModal('detailModal')">إغلاق</button>
        </div>

        <div class="form-grid" style="margin-bottom:14px;">
          <div class="field">
            <label>تغيير مرحلة الملف <span class="en">(Stage)</span></label>
            <select onchange="advanceStage('${m.id}', this.value); openDetailModal('${m.id}')">
              ${STAGES.map(s => `<option value="${s.id}" ${m.stage === s.id ? 'selected' : ''}>${s.ar} (${s.en})</option>`).join('')}
              <option value="cancelled" ${m.stage === 'cancelled' ? 'selected' : ''}>ملغى / لم يُدفع (Cancelled)</option>
            </select>
          </div>
          <div class="field">
            <label>موعد المراجعة / الجلسة القادم</label>
            <input type="date" value="${m.nextDate || ''}" onchange="updateNextDate('${m.id}', this.value)" />
          </div>
        </div>

        <div style="background:var(--surface-soft); padding:12px; border-radius:12px; border:1px solid var(--border); margin-bottom:14px;">
          <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
            <strong>الفوترة والمدفوعات — <span class="en">Billing &amp; Invoices</span></strong>
            <button class="btn-gold btn-sm" onclick="triggerPaymentPortal('${m.id}'); openDetailModal('${m.id}')">+ تحرير فاتورة وفتح منصة المدفوعات</button>
          </div>
          <div class="meta-row">
            <span>الأتعاب المتفق عليها: <strong>${m.fee.toLocaleString()} ${m.currency}</strong></span>
            <span>المدفوع المؤكد: <strong style="color:var(--ok);">${paidTotal.toLocaleString()} ${m.currency}</strong></span>
            <span>قيد الدفع: <strong style="color:var(--warn);">${pendingTotal.toLocaleString()} ${m.currency}</strong></span>
          </div>
          <table>
            <thead>
              <tr>
                <th>رقم الفاتورة</th>
                <th>المبلغ</th>
                <th>التاريخ</th>
                <th>الحالة</th>
                <th>إجراء</th>
              </tr>
            </thead>
            <tbody>${invRows}</tbody>
          </table>
        </div>

        <div style="margin-bottom:12px;">
          <strong>سجل سير العمل والملاحظات — <span class="en">Workflow Log</span></strong>
          <div style="display:flex; gap:8px; margin-top:8px;">
            <input type="text" id="newLogNote" placeholder="أضف إجراءً جديداً، نتيجة جلسة، أو ملاحظة متابعة..." />
            <button class="btn-dark btn-sm" onclick="addTimelineNote('${m.id}')">إضافة</button>
          </div>
          <div style="margin-top:10px; border:1px solid var(--border); border-radius:10px; max-height:190px; overflow-y:auto;">
            ${logsHtml}
          </div>
        </div>
      `;
      document.getElementById('detailModal').classList.add('open');
    }

    function updateNextDate(matterId, newDate) {
      const m = state.matters.find(x => x.id === matterId);
      if (!m) return;
      m.nextDate = newDate;
      m.timeline.unshift({
        date: new Date().toLocaleString('ar-IQ'),
        text: `تحديث موعد الجلسة / المراجعة القادمة إلى: ${newDate || 'غير محدد'}`
      });
      saveState();
    }

    function addTimelineNote(matterId) {
      const inp = document.getElementById('newLogNote');
      const val = inp.value.trim();
      if (!val) return;
      const m = state.matters.find(x => x.id === matterId);
      if (!m) return;
      m.timeline.unshift({
        date: new Date().toLocaleString('ar-IQ'),
        text: val
      });
      saveState();
      openDetailModal(matterId);
    }

    function toggleFeedbackForm() {
      document.getElementById('feedbackForm').classList.toggle('hidden');
    }

    function saveFeedback(e) {
      e.preventDefault();
      const catSel = document.getElementById('fbCategory').value;
      const category = catSel === 'custom' ? (document.getElementById('fbCustomCatInput').value.trim() || 'مخصص') : catSel;
      state.feedbacks.unshift({
        id: Date.now().toString(),
        client: document.getElementById('fbClient').value.trim(),
        matterRef: document.getElementById('fbMatterRef').value.trim(),
        category,
        details: document.getElementById('fbDetails').value.trim(),
        status: 'open',
        resolution: '',
        date: new Date().toISOString().slice(0, 10)
      });
      saveState();
      e.target.reset();
      toggleFeedbackForm();
      showToast('تم تسجيل الملاحظة في السجل');
    }

    function closeFeedback(id) {
      const res = prompt('اكتب الإجراء المتخذ لإغلاق الملاحظة:');
      if (res === null) return;
      const fb = state.feedbacks.find(f => f.id === id);
      if (!fb) return;
      fb.status = 'closed';
      fb.resolution = res.trim() || 'تمت المعالجة والإغلاق';
      saveState();
    }

    function render() {
      document.getElementById('stClients').textContent = state.clients.length;
      document.getElementById('stIncoming').textContent = state.matters.filter(m => m.stage === 'incoming').length;
      document.getElementById('stActive').textContent = state.matters.filter(m => ['accepted', 'pending_payment', 'paid', 'in_progress'].includes(m.stage)).length;
      document.getElementById('stCancelled').textContent = state.matters.filter(m => m.stage === 'cancelled').length;

      let paidCount = 0;
      let iqdSum = 0;
      let usdSum = 0;
      state.matters.forEach(m => {
        (m.invoices || []).forEach(inv => {
          if (inv.status === 'paid') {
            paidCount++;
            if (inv.currency === 'USD') usdSum += Number(inv.amount);
            else iqdSum += Number(inv.amount);
          }
        });
      });
      document.getElementById('stPaidCount').textContent = paidCount;
      const sums = [];
      if (iqdSum > 0 || usdSum === 0) sums.push(`${iqdSum.toLocaleString()} IQD`);
      if (usdSum > 0) sums.push(`${usdSum.toLocaleString()} USD`);
      document.getElementById('stCollected').textContent = sums.join(' + ');

      const q = document.getElementById('searchInput').value.trim().toLowerCase();
      const stFilter = document.getElementById('stageFilter').value;

      const filtered = state.matters.filter(m => {
        if (currentTab === 'incoming' && m.stage !== 'incoming') return false;
        if (['consultation', 'litigation', 'transaction'].includes(currentTab) && m.category !== currentTab) return false;
        if (stFilter && m.stage !== stFilter) return false;
        if (q) {
          const hay = `${m.ref} ${m.barcode || ''} ${m.clientName} ${m.phone} ${m.subject} ${(m.invoices || []).map(i => i.invNo).join(' ')}`.toLowerCase();
          if (!hay.includes(q)) return false;
        }
        return true;
      });

      const sec = document.getElementById('mattersSection');
      if (!filtered.length) {
        sec.innerHTML = `<div class="panel" style="text-align:center; color:var(--muted);">لا توجد ملفات مطابقة حالياً. اضغط <strong>"+ حجز / ملف جديد (باركود)"</strong> للبدء.</div>`;
      } else {
        sec.innerHTML = filtered.map(m => {
          const currentIdx = STAGES.findIndex(s => s.id === m.stage);
          const stepperHtml = m.stage === 'cancelled'
            ? `<span class="step-chip cancelled">ملغى / لم يُدفع (Cancelled)</span>`
            : STAGES.map((s, idx) => {
                const cls = idx < currentIdx ? 'done' : idx === currentIdx ? 'current' : '';
                return `<span class="step-chip ${cls}">${s.ar}</span>`;
              }).join('');

          const badgeCls = m.stage === 'completed' || m.stage === 'paid' ? 'b-ok'
            : m.stage === 'cancelled' ? 'b-danger'
            : m.stage === 'pending_payment' || m.stage === 'incoming' ? 'b-warn' : 'b-info';

          const bc = m.barcode || `BC-${m.ref}`;

          return `
            <article class="matter-card">
              <div class="matter-top">
                <div>
                  <span class="ref-pill">${m.ref}</span>
                  <span class="ref-pill" style="background:#f1f5f9;">${m.clientId}</span>
                  <span style="font-size:12px; color:var(--muted); margin-right:6px;">${categoryLabel(m.category)}</span>
                  <h3 style="margin:6px 0 2px; font-size:16px; color:var(--ink);">${m.subject}</h3>
                  <div style="font-size:13.5px; font-weight:700;">الموكل: ${m.clientName} <span class="en" style="color:var(--muted); font-weight:500;">(${m.phone})</span></div>
                </div>
                <div style="display:flex; flex-direction:column; align-items:flex-end; gap:6px;">
                  <span class="badge ${badgeCls}">${stageLabel(m.stage)}</span>
                  <div class="barcode-box" onclick="copyBarcode('${bc}')" title="نسخ الباركود" style="cursor:pointer;">
                    <div class="barcode-bars"></div>
                    <div class="barcode-code">${bc}</div>
                  </div>
                </div>
              </div>

              <div class="lifecycle">${stepperHtml}</div>

              <div class="meta-row">
                <span>الأتعاب: <strong>${m.fee.toLocaleString()} ${m.currency}</strong></span>
                <span>الفواتير: <strong>${m.invoices.length}</strong></span>
                <span>الموعد القادم: <strong>${m.nextDate || 'غير محدد'}</strong></span>
              </div>

              <div class="card-actions">
                ${m.stage === 'incoming' ? `<button class="btn-ok btn-sm" onclick="advanceStage('${m.id}','accepted','تم قبول الطلب الوارد ونقله إلى مرحلة الفوترة')">تم القبول (Accept)</button>` : ''}
                <button class="btn-gold btn-sm" onclick="triggerPaymentPortal('${m.id}')">تحرير فاتورة / منصة المدفوعات</button>
                <button class="btn-dark btn-sm" onclick="openDetailModal('${m.id}')">فتح الملف والمتابعة</button>
                ${m.stage !== 'archived' ? `<button class="btn-light btn-sm" onclick="advanceStage('${m.id}','archived','تم أرشفة الملف ونقله إلى السجل المرجعي')">أرشفة</button>` : ''}
              </div>
            </article>
          `;
        }).join('');
      }

      document.getElementById('clientsTableBody').innerHTML = state.clients.map(c => {
        const count = state.matters.filter(m => m.clientId === c.id).length;
        return `
          <tr>
            <td class="en"><strong>${c.id}</strong></td>
            <td>${c.name}</td>
            <td class="en">${c.phone}</td>
            <td>${count}</td>
            <td>${c.createdAt}</td>
          </tr>
        `;
      }).join('') || '<tr><td colspan="5" style="text-align:center; color:var(--muted);">لا يوجد موكلون مسجلون بعد</td></tr>';

      document.getElementById('feedbackList').innerHTML = state.feedbacks.map(f => `
        <div class="matter-card" style="border-right-color:${f.status === 'open' ? 'var(--warn)' : 'var(--ok)'};">
          <div class="matter-top">
            <div>
              <strong>${f.client}</strong> ${f.matterRef ? `<span class="ref-pill">${f.matterRef}</span>` : ''}
              <span class="badge b-info">${f.category}</span>
              <p style="margin:6px 0; font-size:13.5px;">${f.details}</p>
              ${f.resolution ? `<div style="font-size:12.5px; color:var(--ok);"><strong>الإجراء المتخذ:</strong> ${f.resolution}</div>` : ''}
            </div>
            <div>
              ${f.status === 'open'
                ? `<button class="btn-ok btn-sm" onclick="closeFeedback('${f.id}')">معالجة وإغلاق</button>`
                : `<span class="badge b-ok">مغلقة (${f.date})</span>`}
            </div>
          </div>
        </div>
      `).join('') || '<div style="text-align:center; color:var(--muted);">لا توجد ملاحظات مسجلة حالياً.</div>';
    }

    function openSettingsModal() {
      document.getElementById('setPaymentUrl').value = state.settings.paymentUrl;
      document.getElementById('settingsModal').classList.add('open');
    }

    async function saveSettings() {
      const url = document.getElementById('setPaymentUrl').value.trim();
      if (url) state.settings.paymentUrl = url;
      const newTok = document.getElementById('setGhToken').value.trim();
      if (newTok) {
        const pin = prompt('أدخل الرقم السري الحالي لتشفير رمز المزامنة:');
        if (pin) {
          const auth = JSON.parse(localStorage.getItem(AUTH_KEY) || '{}');
          auth.encToken = xorCipher(newTok, pin);
          localStorage.setItem(AUTH_KEY, JSON.stringify(auth));
        }
      }
      saveState();
      closeModal('settingsModal');
      showToast('تم حفظ الإعدادات بنجاح');
    }

    function exportBackup() {
      const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `AKH-Matter-Portal-${new Date().toISOString().slice(0, 10)}.json`;
      a.click();
    }

    function importBackup(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        try {
          const data = JSON.parse(reader.result);
          if (data && Array.isArray(data.matters)) {
            state = data;
            saveState();
            closeModal('settingsModal');
            showToast('تمت استعادة البيانات بنجاح');
          }
        } catch {
          showToast('ملف النسخة الاحتياطية غير صالح');
        }
      };
      reader.readAsText(file);
    }

    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.style.display = 'block';
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => { t.style.display = 'none'; }, 3500);
    }

    initAuthScreen();
  </script>
</body>
</html>
