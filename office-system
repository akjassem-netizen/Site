                <option value="طلب استفسار أو متابعة">طلب استفسار أو متابعة</option>
                <option value="تأخر إجراء خارجي / دائرة">تأخر إجراء خارجي / دائرة</option>
                <option value="ملاحظة مالية / فواتير">ملاحظة مالية / فواتير</option>
                <option value="طلب إعادة جدولة موعد">طلب إعادة جدولة موعد</option>
